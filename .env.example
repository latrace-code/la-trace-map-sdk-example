# Copier en .env et renseigner. Vos valeurs (cle, configId, secret) vous ont ete
# communiquees par e-mail.

# Base de l'API SDK (endpoints /geocode, /static-map).
# Production : https://prod.routinglatrace.com (preprod : https://preprod.routinglatrace.com)
LATRACE_API_BASE=https://prod.routinglatrace.com

# Cle publiable (pk_test_* / pk_live_*), envoyee en header X-LaTrace-Key.
LATRACE_API_KEY=

# Id de config (theming + entitlement), resolu par /explore.
LATRACE_CONFIG_ID=

# URL du front qui sert la carte /explore.
# Production : https://app.latrace.com (preprod : https://pre-prod--latrace.netlify.app)
LATRACE_EXPLORE_BASE_URL=https://app.latrace.com

# Secret HMAC de signature des URLs static-map. NE quitte JAMAIS le serveur
# (signe dans server.mjs). Doit egaler le signing_secret de votre cle.
LATRACE_STATIC_SECRET=

# Port du serveur local.
PORT=8080
