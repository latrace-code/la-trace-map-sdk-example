# Copier en .env et renseigner. Les valeurs de demo (preprod) vous ont ete
# communiquees par e-mail / sont testables dans le contrat REST interactif.

# Base de l'API SDK (endpoints /geocode, /static-map). Preprod : https://preprod.routinglatrace.com
LATRACE_API_BASE=

# Cle publiable (pk_test_* / pk_live_*), envoyee en header X-LaTrace-Key.
LATRACE_API_KEY=

# Id de config (theming + entitlement), resolu par /explore.
LATRACE_CONFIG_ID=

# URL du front qui sert la carte /explore. Preprod : https://pre-prod--latrace.netlify.app
LATRACE_EXPLORE_BASE_URL=https://pre-prod--latrace.netlify.app

# Secret HMAC de signature des URLs static-map. NE quitte JAMAIS le serveur
# (signe dans server.mjs). Doit egaler le signing_secret de votre cle.
LATRACE_STATIC_SECRET=

# Port du serveur local.
PORT=8080
